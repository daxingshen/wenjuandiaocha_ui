{
  "name": "wenjuandiaocha_ui",
  "version": "0.0.0",
  "private": true,
  "description": "星卷问卷系统前端 monorepo(engine 内核 + 题型插件 + studio/runtime 两端)",
  "scripts": {
    "dev:studio": "pnpm --filter @xingjuan/studio dev",
    "dev:runtime": "pnpm --filter @xingjuan/runtime dev",
    "build": "pnpm --filter @xingjuan/studio --filter @xingjuan/runtime build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.18.0"
}
